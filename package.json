{
  "name": "@pauleschwarz/pi-verity",
  "version": "0.2.0",
  "description": "Deterministic proof-of-done for coding-agent patches.",
  "type": "module",
  "author": "Paul Schwarz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pauleschwarz/pi-verity.git"
  },
  "homepage": "https://github.com/pauleschwarz/pi-verity#readme",
  "bugs": {
    "url": "https://github.com/pauleschwarz/pi-verity/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "verity": "dist/cli.js",
    "pi-verity": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./adapters/pi": "./dist/adapter-pi/index.js",
    "./adapter-pi": "./dist/adapter-pi/index.js"
  },
  "pi": {
    "extensions": [
      "./dist/adapter-pi/index.js"
    ]
  },
  "files": [
    "dist",
    "schemas",
    "docs/GETTING_STARTED.md",
    "docs/HARNESS_INTEGRATION.md",
    "docs/HOW_IT_WORKS.md",
    "docs/LIMITATIONS.md",
    "docs/evidence",
    "examples/README.md",
    "scripts/prepare.mjs",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "lint": "biome check src test",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run verify",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/adapter-pi.test.ts test/execution-policy.test.ts test/scope-integrity.test.ts test/observable-claims.test.ts test/test-delta.test.ts test/turn-contract.test.ts test/schema.test.ts test/evidence-provider.test.ts test/migration-contract.test.ts",
    "test:integration": "node --import tsx --test test/adapter-pi.lifecycle.test.ts test/counterfactual.test.ts test/verifier.test.ts test/effect-proof.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:dist"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "verification",
    "developer-tools",
    "typescript",
    "pi",
    "agentic-engineering",
    "software-testing",
    "counterfactual-testing",
    "proof-receipt"
  ],
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  }
}
